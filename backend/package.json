{
  "name": "medemergency-backend",
  "version": "1.0.0",
  "description": "Backend server for MedEmergency - Emergency Prescription & Medicine Finder Web App",
  "main": "src/server.js",
  "scripts": {
    "prestart": "node scripts/ensure-db.js",
    "start": "node src/server.js",
    "predev": "node scripts/ensure-db.js",
    "dev": "nodemon src/server.js",
